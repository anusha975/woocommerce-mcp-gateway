# Server & Environment Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Gateway Security (Optional API Key for HTTP/SSE clients)
GATEWAY_API_KEY=

# WooCommerce REST API v3 Credentials
# Target store URL must include scheme, e.g. https://your-store.example.com
WOOCOMMERCE_BASE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_placeholder_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_placeholder_consumer_secret
WOOCOMMERCE_TIMEOUT_MS=10000
WOOCOMMERCE_VERIFY_SSL=true

# Request Controls & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ALLOWED_ORIGINS=*
MAX_REQUEST_BODY_BYTES=1048576
