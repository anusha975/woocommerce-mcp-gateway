# Server & Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Gateway Security (Optional API Key for HTTP/SSE clients)
GATEWAY_API_KEY=

# WooCommerce REST API v3 Credentials
# Target store URL must include scheme, e.g. https://your-store.example.com
WOOCOMMERCE_URL=https://example-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_test_placeholder_key
WOOCOMMERCE_CONSUMER_SECRET=cs_test_placeholder_secret
WOOCOMMERCE_TIMEOUT_MS=10000
WOOCOMMERCE_VERIFY_SSL=true
