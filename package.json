{
  "name": "woocommerce-mcp-gateway",
  "version": "1.0.0",
  "description": "Production-ready Model Context Protocol (MCP) Gateway for WooCommerce store integrations",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "vitest run tests/integration/acceptance-scenarios.test.ts",
    "test:chat": "vitest run tests/integration/chat-agent.test.ts",
    "test:live": "vitest run tests/live",
    "test:e2e": "tsx scripts/verify-e2e.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "helm:validate": "tsx scripts/validate-helm-chart.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "woocommerce",
    "gateway",
    "kubernetes",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.0.6",
    "eslint": "^9.20.1",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.6"
  }
}
